rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isOwner(uid){ return signedIn() && request.auth.uid == uid; }
    function isAdmin(){ return signedIn() && (request.auth.token.admin == true || request.auth.token.email in ['waelelsaydahmed@gmail.com','waelelsaydahmed9916@gmail.com','myway9916@gmail.com','admin@visionmedia.sa']); }
    match /users/{uid} { allow read, update: if isOwner(uid) || isAdmin(); allow create: if signedIn(); allow delete: if isAdmin(); }
    match /orders/{id} { allow create: if signedIn(); allow read, update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid); allow delete: if isAdmin(); }
    match /supportChats/{id} { allow create, read, update: if signedIn(); allow delete: if isAdmin(); }
    match /reviews/{id} { allow read: if true; allow create: if signedIn(); allow update, delete: if isAdmin(); }
    match /fcmTokens/{id} { allow create, update: if signedIn(); allow read, delete: if isAdmin(); }
    match /notifications/{id} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /siteData/{id} { allow read: if true; allow write: if isAdmin(); }
    match /cmsPages/{id} { allow read: if true; allow write: if isAdmin(); }
    match /cmsSections/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
